# =============================================================================
# Flask / App
# =============================================================================
SECRET_KEY=change-me

# =============================================================================
# Base de datos
# =============================================================================
# Si no se define, usa SQLite local (sqlite:///app.db).
# En docker-compose se arma como: postgresql://nautica:${POSTGRES_PASSWORD}@db:5432/nautica
# DATABASE_URL=postgresql://nautica:change-me@db:5432/nautica
POSTGRES_PASSWORD=change-me

# =============================================================================
# Sitio público (usado en serializers, links de catálogo, etc.)
# =============================================================================
# PUBLIC_SITE_URL=https://mgnautica.com

# =============================================================================
# Seed de admin (scripts/seed_db.py)
# =============================================================================
# ADMIN_EMAIL=admin@mgnautica.local
# ADMIN_PASSWORD=changeme-admin
# ADMIN_NAME=Admin

# =============================================================================
# Mercado Libre OAuth (scan_meli.py y publicación desde admin)
# =============================================================================
# Creá la app en: https://developers.mercadolibre.com.ar/apps
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
# Debe coincidir exactamente con el redirect URI configurado en la app de ML
MELI_REDIRECT_URI=http://localhost:5000/admin/meli/callback

# Tokens iniciales por sitio (opcional pero recomendado para despliegues).
# Si no hay credenciales en DB para un sitio, la app los carga al arrancar.
# El auto-refresh sigue funcionando y actualiza los tokens en DB automáticamente.
# Obtené los tokens una sola vez desde Admin → Mercado Libre → Conectar cuenta
# y luego copiá los valores de la DB a estas variables para futuros deploys.
MELI_MLU_ACCESS_TOKEN=
MELI_MLU_REFRESH_TOKEN=
MELI_MLU_USER_ID=
MELI_MLA_ACCESS_TOKEN=
MELI_MLA_REFRESH_TOKEN=
MELI_MLA_USER_ID=

# =============================================================================
# Instagram Graph API (publicación de embarcaciones)
# =============================================================================
# Creá una app en: https://developers.facebook.com/ con permisos
# instagram_basic e instagram_content_publish.
# El access token debe ser de larga duración (long-lived) de la cuenta Business.
# Si estas variables están vacías, Instagram queda deshabilitado automáticamente.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# =============================================================================
# Facebook Page API (publicación en página de Facebook)
# =============================================================================
# Mismo flow que Instagram: app de Meta con permisos pages_manage_posts y
# pages_read_engagement. Page Access Token de larga duración.
# Si están vacías, Facebook queda deshabilitado automáticamente.
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# =============================================================================
# WhatsApp Catalog (sincronización de productos al catálogo Business)
# =============================================================================
# Catalog ID del Business Manager + token con permiso catalog_management.
# Si están vacías, WhatsApp queda deshabilitado automáticamente.
WHATSAPP_CATALOG_ID=
WHATSAPP_ACCESS_TOKEN=

# =============================================================================
# YouTube Data API v3 (subida de videos de embarcaciones)
# =============================================================================
# Creá las credenciales OAuth en: https://console.cloud.google.com/
# Habilitá YouTube Data API v3 y generá el refresh token con scope
# https://www.googleapis.com/auth/youtube.upload.
# Si alguna de las tres está vacía, YouTube queda deshabilitado automáticamente.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
