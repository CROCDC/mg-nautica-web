SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me

# Mercado Libre OAuth (necesario para scan_meli.py y publicación desde admin)
# Creá la app en: https://developers.mercadolibre.com.ar/apps
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
# Debe coincidir exactamente con el redirect URI configurado en la app de ML
MELI_REDIRECT_URI=http://localhost:5000/admin/meli/callback

# Instagram Graph API (publicación de embarcaciones)
# Creá una app en: https://developers.facebook.com/ con permisos instagram_basic e instagram_content_publish
# El access token debe ser de larga duración (long-lived) de la cuenta Business
# Si estas variables están vacías, Instagram queda deshabilitado automáticamente
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
